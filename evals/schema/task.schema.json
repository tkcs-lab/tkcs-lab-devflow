{
  "$comment": "Subset of JSON Schema understood by src/tld/profile/validate.py:check (type, enum, required, properties, items, minimum, pattern, oneOf, additionalProperties).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "fixture", "graders"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1},
    "command": {"type": "string", "pattern": "^/[a-z0-9:-]+$"},
    "arguments": {"type": "string"},
    "prompt": {"type": "string", "minLength": 1},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builder": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
        "params": {"type": "object"}
      }
    },
    "expected": {"type": "object"},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {"type": "string", "minLength": 1, "pattern": "^[^-]"},
        "extra": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
      }
    },
    "model": {"type": "string", "minLength": 1},
    "repeats": {"type": "integer", "minimum": 1},
    "timeout_s": {"type": "integer", "minimum": 10},
    "cost_ceiling_usd": {"$comment": "positive number; checked in taskspec.py (the validator subset has no number type)"},
    "requires": {"type": "array", "items": {"type": "string"}},
    "graders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}
        ]
      }
    }
  }
}
